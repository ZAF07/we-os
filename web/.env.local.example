# =============================================================================
# we-OS frontend — example environment
# Copy to `.env.local` and fill in:  cp .env.local.example .env.local
#
# `.env.local` is gitignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk (identity)
# -----------------------------------------------------------------------------
# From the Clerk dashboard → API keys. The publishable key is safe in the
# browser; the secret key is server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Where Clerk's hosted sign-in / sign-up flows live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Engine
# -----------------------------------------------------------------------------
# The FastAPI harness. The BFF forwards the verified token here; the engine
# verifies it independently and derives the tenant from the claim (ADR-0013).
# Server-only: the browser never calls the engine directly.
ENGINE_BASE_URL=http://127.0.0.1:8000

# Optional. Set only if you configured an `aud` claim in your Clerk JWT
# template; it must then match MARKETING_OS_AUTH_AUDIENCE in the engine's .env.
# CLERK_JWT_AUDIENCE=we-os

# -----------------------------------------------------------------------------
# End-to-end tests
# -----------------------------------------------------------------------------
# Every signed-in route is behind clerkMiddleware, so `pnpm test` signs in
# first. The suite needs *two* dedicated test users in your Clerk *development*
# instance, each in its own Organization — the engine derives the tenant from the organization
# claim on the session token, so two tenants means two organizations.
#
# No password is needed for either: sign-in mints a ticket through Clerk's
# Backend API using CLERK_SECRET_KEY, so no test password is ever stored. Never
# point these at real accounts. Each user must be a member of its organization,
# or the engine sees no tenant claim and refuses the request.

# The seeded user. Its tenant gets a complete Brand DNA, so campaign specs can
# reach the pipeline.
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com

# The Clerk Organization that test user belongs to. The e2e stack seeds a Brand
# DNA against this id before the suite runs, so specs can assert on a *named*
# Audience Segment. It is needed because a tenant id is minted randomly
# (`ten_<uuid4>`) on first sign-in and so cannot be known in advance — the seed
# writes the tenants row itself, pairing a fixed tenant id to this organization.
# Find it in the Clerk dashboard under Organizations.
E2E_CLERK_ORG_ID=org_REPLACE_ME

# The blank user, in a *second* Organization. Its tenant is seeded with no Brand
# DNA at all — and re-blanked on every stack start — so the onboarding specs can
# exercise the wizard's required-field gating and walk it end to end. Must be a
# different organization from E2E_CLERK_ORG_ID; the seed refuses two identical
# ids, since one pairing would make both tenants the same business.
E2E_CLERK_BLANK_USER_EMAIL=e2e+clerk_test_blank@example.com
E2E_CLERK_BLANK_ORG_ID=org_REPLACE_ME_TOO

# The tenantless user, in *no* Organization. The tenantless project signs in as
# this user to prove that a session with no business is kept out of the app
# half, and to walk the Welcome flow that creates one. Its specs create an
# Organization for the user and delete it again afterwards, so it must be a
# user nothing else relies on. No organization id: the point is that there is
# none.
E2E_CLERK_TENANTLESS_USER_EMAIL=e2e+clerk_test_tenantless@example.com

# The engine's OIDC issuer, repeated here so the e2e compose stack can pass it
# to the engine container. Same value as MARKETING_OS_AUTH_ISSUER in
# agent-harness/.env — your Clerk instance's Frontend API URL.
MARKETING_OS_AUTH_ISSUER=https://REPLACE_ME.clerk.accounts.dev

# -----------------------------------------------------------------------------
# Clerk setup checklist (one-time, in the Clerk dashboard)
# -----------------------------------------------------------------------------
# 1. Enable Organizations, keep "allow users to create organizations" on —
#    Welcome creates the business from the browser as the signed-in person, and
#    Clerk stamps that permission onto each user as it is created — and in the
#    Organizations settings choose "Membership optional" (Personal Accounts on)
#    rather than the default "Membership required". We-OS creates the Organization itself, on the
#    Welcome page, once a tier has been chosen (ADR-0027): Clerk authenticates
#    the person and must not author the business. One Clerk Organization == one
#    business == one we-OS tenant (ADR-0013). With membership required, Clerk
#    holds every new session on a "choose-organization" task and demands an
#    organization before the app is reached, so the welcome flow never runs —
#    which is why this is the checklist item most worth re-reading on a fresh
#    instance.
# 2. Confirm the session token carries the organization. Clerk's current token
#    (v2) nests it as `o.id`; older v1 tokens spell it `org_id`. The engine
#    reads either, and refuses a token carrying neither rather than falling back to
#    the user id — which would weld a business to a single login permanently.
# 3. Copy your instance's Frontend API URL (https://<slug>.clerk.accounts.dev)
#    into MARKETING_OS_AUTH_ISSUER in agent-harness/.env.
# 4. Put the signed-in email on the session token, so the engine knows where to
#    send the Brand DNA review reminder (ADR-0028): Sessions -> Customize
#    session token, add {"email": "{{user.primary_email_address}}"}. The e2e
#    stack does not depend on it — the seed records the seeded user's address
#    itself — but a business you sign up by hand is only emailed if the token
#    carries one.
