# =============================================================================
# we-OS — local development stack
# Copy to `.env` and fill in:  cp .env.example .env
#
# This one file feeds the whole stack (`make dev`): the database, the engine
# and the web app. `.env` is gitignored — never commit real keys.
#
# Running the apps natively instead (`uv run` / `pnpm dev`) uses the per-app
# files, `agent-harness/.env` and `web/.env.local`. This file is for compose.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk (identity) — REQUIRED, the app is unusable without it
# -----------------------------------------------------------------------------
# Every route is behind Clerk and the engine derives your tenant from the
# organization claim, so there is no anonymous mode to fall back to.
# From the Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Your Clerk instance's Frontend API URL. The engine fetches this issuer's JWKS
# and verifies tokens itself, so no secret key belongs on the engine side
# (ADR-0013). Same value as MARKETING_OS_AUTH_ISSUER in agent-harness/.env.
MARKETING_OS_AUTH_ISSUER=https://REPLACE_ME.clerk.accounts.dev

# -----------------------------------------------------------------------------
# LLM provider — REQUIRED to run a campaign
# -----------------------------------------------------------------------------
# The stack starts without this and every screen works: you can sign up,
# onboard, fill in the Brand DNA and create a campaign. The pipeline fails at
# its first model call, so set it before running one.
#
# DeepSeek is the default provider (ADR-0004). To use another, set
# MARKETING_OS_PROVIDER=anthropic|openai and supply that provider's key
# instead — note the engine image installs the deepseek client only.
DEEPSEEK_API_KEY=sk-REPLACE_ME

# -----------------------------------------------------------------------------
# Web search — optional
# -----------------------------------------------------------------------------
# Off by default. Set to 1 for the research stage to search the live web.
MARKETING_OS_WEB=0

# Tavily is the primary backend (ADR-0011); without a key, search falls back to
# scraping. Only read when MARKETING_OS_WEB=1.
MARKETING_OS_TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Clerk setup checklist (one-time, in the Clerk dashboard)
# -----------------------------------------------------------------------------
# 1. Enable Organizations, and turn on "create an organization on sign-up".
#    One Clerk Organization == one business == one we-OS tenant (ADR-0013).
# 2. Confirm the session token carries the organization. Clerk's current token
#    (v2) nests it as `o.id`; older v1 tokens spell it `org_id`. The engine
#    reads either and refuses a token carrying neither.
